# Copier ce fichier en `.env` et remplir les valeurs. `.env` n'est jamais commité.

# Clé API Giphy (phase 3) — https://developers.giphy.com/ (type « API », pas « SDK »)
GIPHY_API_KEY=

# Fichier du cache des GIF (facultatif, par défaut data/gif-cache.json)
# GIF_CACHE_FILE=data/gif-cache.json

# Sel secret pour hacher les IP de la limite de débit (phase 4). Une longue chaîne aléatoire.
VOTE_HASH_SALT=

# Dossier du cache des images de partage (facultatif, par défaut data/og)
# OG_CACHE_DIR=data/og

# Base SQLite des votes (facultatif, par défaut data/votes.sqlite)
# VOTES_DB_FILE=data/votes.sqlite

# Derrière un proxy (O2Switch), mettre true pour lire l'IP réelle dans X-Forwarded-For
# TRUST_PROXY=false
