# Copier ce fichier en `.env` et remplir les valeurs. `.env` n'est jamais commité.

# Clé API Giphy — https://developers.giphy.com/ (type « API », pas « SDK »)
# Le site l'envoie au navigateur, qui appelle Giphy lui-même (règle de GIPHY).
# En local, une clé de dev à part de celle du serveur : `npm run dev` et la page d'admin
# (`npm run gif-admin`) ne puisent pas dans le quota du site en ligne.
GIPHY_API_KEY=

# Sel secret pour hacher les IP de la limite de débit (phase 4). Une longue chaîne aléatoire.
VOTE_HASH_SALT=

# Dossier du cache des images de partage (facultatif, par défaut data/og)
# OG_CACHE_DIR=data/og

# Base SQLite des votes (facultatif, par défaut data/votes.sqlite)
# VOTES_DB_FILE=data/votes.sqlite

# Derrière un proxy (O2Switch), mettre true pour lire l'IP réelle dans X-Forwarded-For
# TRUST_PROXY=false

# Jeton secret du diagnostic d'adresse IP (GET /api/health?ip). Une longue chaîne aléatoire.
# Le nom vient des anciens signalements de GIF ; il est gardé pour ne rien changer sur le serveur.
# Vide : le diagnostic n'est pas accessible.
# GIF_REPORT_TOKEN=

# Mode développement sans Giphy : GIF de remplacement, la clé n'est jamais envoyée au navigateur.
# Plutôt que de l'écrire ici, lancer `npm run dev:sans-giphy`. Jamais en production.
# GIPHY_OFFLINE=false
