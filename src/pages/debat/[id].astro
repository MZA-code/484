---
/**
 * /debat/<id> : une page par rivalité, pour pouvoir partager un affrontement précis.
 * Titre, description et image de partage sont propres à la rivalité ; la page contient aussi
 * le débat en HTML statique, le fil d'Ariane et des liens vers d'autres débats de la catégorie.
 */
import DebatePage from '../../components/DebatePage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { rivalries, ui } from '../../data/content';
import { categoryById, categoryPath, debatePath, questionOf, rivalriesOf } from '../../data/pages';
import { teamColors } from '../../lib/color';
import { formatText } from '../../lib/format';
import { ogImagePath } from '../../lib/og-path';
import { debateJsonLd, relatedRivalries } from '../../lib/seo';

export function getStaticPaths() {
  return rivalries.map((r) => ({ params: { id: r.id }, props: { rivalry: r } }));
}

/** Nombre de débats voisins proposés sous le jeu. */
const RELATED_COUNT = 8;

const { rivalry } = Astro.props;
const question = questionOf(rivalry);
const category = categoryById.get(rivalry.category);
const categoryLabel = category?.label ?? rivalry.category;
const description = formatText(ui.debate.shareDescription, {
  a: rivalry.a.name,
  b: rivalry.b.name,
});
const [colorA, colorB] = teamColors(rivalry.id);
const team = (t: typeof rivalry.a, color: string) => ({
  name: t.name,
  origin: t.origin,
  line: t.line,
  color,
});
const related = relatedRivalries(rivalry, rivalries, RELATED_COUNT).map((r) => ({
  id: r.id,
  question: questionOf(r),
}));
const categoryCount = rivalriesOf(rivalry.category).length;
const jsonLd = [
  debateJsonLd(
    {
      question,
      description,
      path: debatePath(rivalry.id),
      category: categoryLabel,
      a: rivalry.a,
      b: rivalry.b,
    },
    Astro.site ?? Astro.url,
  ),
];
---

<DebatePage
  title={question}
  description={description}
  jsonLd={jsonLd}
  initialRivalry={rivalry.id}
  image={ogImagePath(rivalry.id)}
  staticDebate={{
    question,
    category: categoryLabel,
    a: team(rivalry.a, colorA),
    b: team(rivalry.b, colorB),
  }}
>
  <aside class="debate-more" slot="after" aria-labelledby="autres-debats">
    <Breadcrumbs
      crumbs={[
        { name: ui.breadcrumb.home, path: '/' },
        { name: ui.breadcrumb.debates, path: '/debats' },
        { name: categoryLabel, path: categoryPath(rivalry.category) },
        { name: question },
      ]}
    />
    <h2 class="more-title" id="autres-debats">
      {formatText(ui.debateAbout.related, { category: categoryLabel })}
    </h2>
    <ul class="more-list">
      {related.map((r) => (
        <li>
          <a href={debatePath(r.id)}>{r.question}</a>
        </li>
      ))}
    </ul>
    <a class="more-category" href={categoryPath(rivalry.category)}>
      {formatText(ui.debateAbout.categoryLink, { n: categoryCount, category: categoryLabel })}
    </a>
  </aside>
</DebatePage>

<style>
  .debate-more {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid #3a3a3a;
  }

  .more-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .more-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-list li {
    border-bottom: 1px solid #2c2c2c;
  }

  .more-list a {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--fg);
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .more-list a:hover,
  .more-list a:focus-visible {
    color: var(--yellow);
    transform: translateX(6px);
  }

  .more-category {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    color: var(--yellow);
    font-family: var(--font-mono);
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .more-category:hover {
    color: #fff;
  }
</style>
