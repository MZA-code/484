---
/** Mes autres projets : grille de cartes colorées construite depuis `ui.projects`. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../data/content';
import { CARD_COLORS } from '../lib/color';

// On commence au rose : le jaune est déjà pris par le logo.
const projects = ui.projects.map((project, i) => ({
  ...project,
  color: CARD_COLORS[(i + 1) % CARD_COLORS.length],
}));
---

<BaseLayout title={ui.projectsPage.title}>
  <section class="container projects">
    <h1 class="title">{ui.projectsPage.title}</h1>
    <p class="intro">{ui.projectsPage.intro}</p>

    <ul class="grid">
      {projects.map((project) => (
        <li>
          <a
            class="card"
            href={project.url}
            target="_blank"
            rel="noopener"
            style={`--card: ${project.color}`}
          >
            <span class="label kind">{project.kind}</span>
            <span class="name">{project.title}</span>
            <span class="text">{project.text}</span>
            <span class="cta">
              {project.cta} <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <a class="block-button back" href="/jouer">
      {ui.projectsPage.back}
    </a>
  </section>
</BaseLayout>

<style>
  .projects {
    padding-top: clamp(24px, 5vw, 56px);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .intro {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 1.125rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 28px;
    margin: 40px 0 48px;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition: transform 160ms ease;
  }

  .card:hover {
    transform: translateY(-6px) rotate(-1deg);
  }

  .kind {
    font-weight: 700;
  }

  .name {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .text {
    flex: 1;
  }

  .cta {
    font-family: var(--font-mono);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
