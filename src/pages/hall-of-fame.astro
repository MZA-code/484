---
/** Hall of Fame : le verdict mondial des débats, d'après les votes de tous les visiteurs. */
import BaseLayout from '../layouts/BaseLayout.astro';
import HallOfFame, { questionFor, type HallData } from '../islands/hall/HallOfFame';
import { categories, rivalries, ui } from '../data/content';

const data: HallData = {
  categories: categories.map(({ id, label }) => ({ id, label })),
  rivalries: rivalries.map((r) => ({
    id: r.id,
    category: r.category,
    question: questionFor(r, ui.debate.question),
    a: r.a.name,
    b: r.b.name,
  })),
  mixedLabel: ui.home.mixedTheme.label,
  texts: ui.hallOfFame,
};
---

<BaseLayout title={ui.hallOfFame.pageTitle}>
  <section class="container hall-page">
    <h1 class="title">{ui.hallOfFame.title}</h1>
    <p class="intro">{ui.hallOfFame.intro}</p>
    <HallOfFame client:only="preact" data={data}>
      <p slot="fallback" class="fallback">
        {ui.hallOfFame.loading}
      </p>
    </HallOfFame>
    <a class="block-button back" href="/jouer">
      {ui.hallOfFame.play}
    </a>
  </section>
</BaseLayout>

<style>
  .hall-page {
    padding-top: 8px;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .intro {
    max-width: 40rem;
    margin-top: 12px;
    font-size: 1.125rem;
  }

  .fallback {
    min-height: 60vh;
    padding-top: 96px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .back {
    margin-top: 56px;
  }
</style>
