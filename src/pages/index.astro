---
/**
 * Accueil : titre géant, chapeau, « Tout mélangé », puis les catégories regroupées par univers.
 * Aucun texte en dur : tout vient de `content/`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { categories, rivalries, ui, universes } from '../data/content';
import { MIXED_CATEGORY } from '../engine/debate';
import { formatText, plural } from '../lib/format';

/** Ordre des couleurs du prototype : crème, jaune, rose, bleu, orange, puis le reste de la palette. */
const HOME_COLORS = [
  'var(--cream)',
  'var(--yellow)',
  'var(--pink)',
  'var(--blue)',
  'var(--orange)',
  'var(--green)',
  'var(--purple)',
  'var(--red)',
];

const countIn = (categoryIds: readonly string[]) =>
  rivalries.filter((r) => categoryIds.includes(r.category)).length;
const label = new Map(categories.map((c) => [c.id, c] as const));

/** Les couleurs défilent d'une carte à l'autre sur toute la page ; --i règle la cascade d'entrée. */
let index = 0;
const card = (id: string, name: string, tagline: string, icon: IconName, n: number) => {
  const i = index++;
  return {
    id,
    name,
    tagline,
    icon,
    href: `/jouer?theme=${id}`,
    count: formatText(ui.home.themeCount, { n }),
    style: `--card: ${HOME_COLORS[i % HOME_COLORS.length]}; --i: ${i}`,
  };
};

const mixed = card(
  MIXED_CATEGORY,
  ui.home.mixedTheme.label,
  ui.home.mixedTheme.tagline,
  ui.home.mixedTheme.icon,
  rivalries.length,
);
const sections = universes.map((u) => ({
  ...u,
  href: `/jouer?theme=${u.id}`,
  count: plural(ui.home.universeCount, countIn(u.categories)),
  cards: u.categories.map((id) => {
    const c = label.get(id);
    return card(id, c?.label ?? id, c?.tagline ?? '', c?.icon ?? 'star', countIn([id]));
  }),
}));
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-text">
      <h1 class="hero-title">
        {ui.home.title.map((line, i) => (
          <span style={`--i: ${i}`}>{line}</span>
        ))}
      </h1>
      <p class="hero-intro">{ui.home.intro}</p>
    </div>

    <h2 class="visually-hidden">{ui.home.themesLabel}</h2>
    <a class="theme-card theme-card--mixed" href={mixed.href} style={mixed.style}>
      <Icon name={mixed.icon} class="theme-icon" />
      <span class="theme-count">{mixed.count}</span>
      <span class="theme-name">{mixed.name}</span>
      <span class="theme-tagline">{mixed.tagline}</span>
      <span class="theme-play">{ui.home.play}</span>
    </a>

    {sections.map((section) => (
      <section class="universe" aria-labelledby={section.id}>
        <div class="universe-head">
          <h3 class="universe-title" id={section.id}>
            <Icon name={section.icon} class="universe-icon" />
            {section.label}
          </h3>
          <p class="universe-tagline">{section.tagline}</p>
          <a class="universe-play" href={section.href}>
            {ui.home.playUniverse} <span class="universe-count">{section.count}</span>
          </a>
        </div>
        <ul class="theme-grid">
          {section.cards.map((c) => (
            <li>
              <a class="theme-card" href={c.href} style={c.style}>
                <Icon name={c.icon} class="theme-icon" />
                <span class="theme-count">{c.count}</span>
                <span class="theme-name">{c.name}</span>
                <span class="theme-tagline">{c.tagline}</span>
                <span class="theme-play">{ui.home.play}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="footnote">{ui.home.footnote}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 24px;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /*
   * La phrase du prototype, en Anton géant ; la troisième ligne en rose.
   * Taille calculée pour que « un portfolio sérieux. » tienne sur une ligne de 360 à 1280 px.
   */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 9.4vw, 8rem);
    /* Assez d'interligne pour que les accents (É) et la cédille (Ç) ne mordent pas sur les lignes voisines. */
    line-height: 1.1;
    text-transform: uppercase;
    /* Place pour la cédille de « ÇA » au-dessus du chapeau. */
    padding-bottom: 0.08em;
  }

  /* Les trois lignes arrivent l'une après l'autre ; la rose avec un petit rebond. */
  .hero-title span {
    display: block;
    animation: title-rise 620ms cubic-bezier(0.2, 0.9, 0.3, 1.1) backwards;
    animation-delay: calc(var(--i) * 120ms);
  }

  .hero-title span:last-child {
    color: var(--pink);
    animation-name: title-pop;
  }

  @keyframes title-rise {
    from {
      opacity: 0;
      transform: translateY(0.45em) rotate(-1.5deg);
    }
  }

  @keyframes title-pop {
    0% {
      opacity: 0;
      transform: translateY(0.45em) scale(0.92) rotate(-4deg);
    }
    70% {
      opacity: 1;
      transform: translateY(0) scale(1.03) rotate(1deg);
    }
    100% {
      transform: none;
    }
  }

  .hero-intro {
    max-width: 680px;
    font-size: 1.25rem;
    animation: rise-in 520ms ease-out 420ms backwards;
  }

  /* « Tout mélangé » : une grande carte en tête, en largeur. */
  .theme-card.theme-card--mixed {
    min-height: 0;
  }

  .theme-card--mixed .theme-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .universe {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .universe-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 20px;
    animation: rise-in 500ms ease-out 400ms backwards;
  }

  .universe-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .universe-tagline {
    flex: 1 1 280px;
    color: var(--fg-muted);
  }

  .universe-play {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--yellow);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .universe-count {
    margin-left: 0.5em;
    color: var(--fg-muted);
    font-weight: 400;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    min-height: 250px;
    padding: 22px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--fg);
    text-decoration: none;
    transition:
      transform 180ms cubic-bezier(0.2, 0.9, 0.3, 1.4),
      box-shadow 180ms ease;
    /* Les cartes tombent en cascade après le titre. */
    animation: card-drop 520ms cubic-bezier(0.2, 0.9, 0.3, 1.25) backwards;
    animation-delay: calc(480ms + min(var(--i), 8) * 70ms);
  }

  .theme-card:hover {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow: 10px 10px 0 var(--fg);
  }

  .theme-card:hover .theme-play {
    transform: translateX(6px);
  }

  /* Icône en filigrane dans le coin de la carte ; elle gigote au survol. */
  .theme-card {
    position: relative;
    overflow: hidden;
  }

  .theme-card :global(.theme-icon) {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 52px;
    height: 52px;
    opacity: 0.85;
    transform: rotate(8deg);
    transition: transform 220ms cubic-bezier(0.2, 0.9, 0.3, 1.6);
  }

  .theme-card:hover :global(.theme-icon) {
    transform: rotate(-10deg) scale(1.18);
  }

  .theme-card--mixed :global(.theme-icon) {
    width: clamp(64px, 9vw, 110px);
    height: clamp(64px, 9vw, 110px);
    top: 50%;
    right: clamp(20px, 4vw, 48px);
    margin-top: calc(clamp(64px, 9vw, 110px) / -2);
  }

  /* Le nom ne passe pas sous l'icône. */
  .theme-card .theme-count,
  .theme-card .theme-name {
    padding-right: 64px;
  }

  .universe-title {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .universe-title :global(.universe-icon) {
    width: 0.8em;
    height: 0.8em;
    color: var(--yellow);
  }

  @keyframes card-drop {
    from {
      opacity: 0;
      transform: translateY(40px) rotate(-3deg) scale(0.94);
    }
  }

  .theme-count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .theme-name {
    font-family: var(--font-display);
    font-size: 2.125rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .theme-tagline {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .theme-play {
    transition: transform 180ms ease;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .footnote {
    animation: rise-in 500ms ease-out 1100ms backwards;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
