---
/**
 * Accueil : titre géant, chapeau, une carte par catégorie (« Tout mélangé » d'abord).
 * Aucun texte en dur : tout vient de `content/`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, rivalries, ui } from '../data/content';
import { MIXED_CATEGORY } from '../engine/debate';
import { formatText } from '../lib/format';

/** Ordre des couleurs du prototype : crème, jaune, rose, bleu, orange, puis le reste de la palette. */
const HOME_COLORS = [
  'var(--cream)',
  'var(--yellow)',
  'var(--pink)',
  'var(--blue)',
  'var(--orange)',
  'var(--green)',
  'var(--purple)',
  'var(--red)',
];

const countFor = (id: string) =>
  id === MIXED_CATEGORY ? rivalries.length : rivalries.filter((r) => r.category === id).length;

const cards = [
  { id: MIXED_CATEGORY, ...ui.home.mixedTheme },
  ...categories.map((c) => ({ id: c.id, label: c.label, tagline: c.tagline })),
].map((card, i) => ({
  ...card,
  href: `/jouer?theme=${card.id}`,
  count: formatText(ui.home.themeCount, { n: countFor(card.id) }),
  color: HOME_COLORS[i % HOME_COLORS.length],
}));
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-text">
      <h1 class="hero-title">
        {ui.home.title.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="hero-intro">{ui.home.intro}</p>
    </div>

    <h2 class="visually-hidden">{ui.home.themesLabel}</h2>
    <ul class="theme-grid">
      {cards.map((card) => (
        <li>
          <a class="theme-card" href={card.href} style={`--card: ${card.color}`}>
            <span class="theme-count">{card.count}</span>
            <span class="theme-name">{card.label}</span>
            <span class="theme-tagline">{card.tagline}</span>
            <span class="theme-play">{ui.home.play}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="footnote">{ui.home.footnote}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 24px;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /*
   * La phrase du prototype, en Anton géant ; la troisième ligne en rose.
   * Taille calculée pour que « un portfolio sérieux. » tienne sur une ligne de 360 à 1280 px.
   */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 9.4vw, 8rem);
    /* Assez d'interligne pour que les accents (É) et la cédille (Ç) ne mordent pas sur les lignes voisines. */
    line-height: 1.1;
    text-transform: uppercase;
    /* Place pour la cédille de « ÇA » au-dessus du chapeau. */
    padding-bottom: 0.08em;
  }

  .hero-title span {
    display: block;
  }

  .hero-title span:last-child {
    color: var(--pink);
  }

  .hero-intro {
    max-width: 680px;
    font-size: 1.25rem;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    min-height: 250px;
    padding: 22px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--fg);
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .theme-card:hover {
    transform: translateY(-6px) rotate(-1deg);
  }

  .theme-count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .theme-name {
    font-family: var(--font-display);
    font-size: 2.125rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .theme-tagline {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .theme-play {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .footnote {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
