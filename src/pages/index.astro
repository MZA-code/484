---
/**
 * Accueil : titre géant, chapeau, « Tout mélangé », puis les catégories regroupées par univers.
 * Aucun texte en dur : tout vient de `content/`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { categories, ui, universes } from '../data/content';
import { MIXED_CATEGORY } from '../engine/debate';

/** Ordre des couleurs du prototype : crème, jaune, rose, bleu, orange, puis le reste de la palette. */
const HOME_COLORS = [
  'var(--cream)',
  'var(--yellow)',
  'var(--pink)',
  'var(--blue)',
  'var(--orange)',
  'var(--green)',
  'var(--purple)',
  'var(--red)',
];

/** Fiche schema.org du site, sur l'accueil seulement. */
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ui.site.title,
  alternateName: ui.site.domain,
  url: new URL('/', Astro.site ?? Astro.url).href,
  description: ui.site.description,
  inLanguage: 'fr-FR',
};

const label = new Map(categories.map((c) => [c.id, c] as const));

/** Les couleurs défilent d'une carte à l'autre sur toute la page ; --i règle la cascade d'entrée. */
let index = 0;
const card = (id: string, name: string, tagline: string, icon: IconName) => {
  const i = index++;
  return {
    id,
    name,
    tagline,
    icon,
    href: `/jouer?theme=${id}`,
    style: `--card: ${HOME_COLORS[i % HOME_COLORS.length]}; --i: ${i}`,
  };
};

const mixed = card(
  MIXED_CATEGORY,
  ui.home.mixedTheme.label,
  ui.home.mixedTheme.tagline,
  ui.home.mixedTheme.icon,
);
const sections = universes.map((u) => ({
  ...u,
  href: `/jouer?theme=${u.id}`,
  cards: u.categories.map((id) => {
    const c = label.get(id);
    return card(id, c?.label ?? id, c?.tagline ?? '', c?.icon ?? 'star');
  }),
}));
---

<BaseLayout jsonLd={[websiteJsonLd]}>
  <section class="hero container">
    <div class="hero-text">
      <h1 class="hero-title">
        {ui.home.title.map((line, i) => (
          <span style={`--i: ${i}`}>{line}</span>
        ))}
      </h1>
      <p class="hero-intro">{ui.home.intro}</p>
    </div>

    <h2 class="visually-hidden">{ui.home.themesLabel}</h2>
    <a class="theme-card theme-card--mixed" href={mixed.href} style={mixed.style}>
      <Icon name={mixed.icon} class="theme-icon" />
      <span class="theme-name">{mixed.name}</span>
      <span class="theme-tagline">{mixed.tagline}</span>
      <span class="theme-play">{ui.home.play}</span>
    </a>

    {sections.map((section) => (
      <section class="universe" aria-labelledby={section.id}>
        <div class="universe-head">
          <h3 class="universe-title" id={section.id}>
            <Icon name={section.icon} class="universe-icon" />
            {section.label}
          </h3>
          <p class="universe-tagline">{section.tagline}</p>
          <a class="universe-play" href={section.href}>
            {ui.home.playUniverse}
          </a>
        </div>
        <ul class="theme-grid">
          {section.cards.map((c) => (
            <li>
              <a class="theme-card" href={c.href} style={c.style}>
                {/* Vignette animée (GIF d'ambiance de la catégorie) ; l'icône reste visible
                    tant qu'elle charge, et pour toujours si elle échoue. */}
                <span class="theme-media" data-category-gif={c.id} aria-hidden="true">
                  <Icon name={c.icon} class="theme-icon" />
                  <span class="theme-loader">
                    <span />
                    <span />
                    <span />
                  </span>
                </span>
                <span class="theme-name">{c.name}</span>
                <span class="theme-tagline">{c.tagline}</span>
                <span class="theme-play">{ui.home.play}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="footnote">{ui.home.footnote}</p>
  </section>
</BaseLayout>

<script>
  import { giphyClientFor, thumbnailOf, type CategoryGiphyPlan } from '../lib/giphy';
  import { MOTION_EVENT, prefersReducedMotion } from '../lib/motion-pref';

  /**
   * Vignettes animées des catégories : chargées seulement à l'approche de l'écran, en image
   * fixe si les animations sont réduites. Le site dit quoi demander, le navigateur appelle
   * Giphy lui-même (règles de GIPHY). En cas d'échec, l'icône reste : rien ne casse.
   */
  interface Thumbnail {
    mp4: string;
    still: string;
  }

  /** Indicateur de chargement seulement si l'attente dure : une réponse rapide ne clignote pas. */
  const LOADER_DELAY_MS = 300;

  const frames = [...document.querySelectorAll<HTMLElement>('[data-category-gif]')];
  const thumbnails = new Map<HTMLElement, Thumbnail>();

  function show(frame: HTMLElement, gif: Thumbnail) {
    frame.querySelector('.theme-gif')?.remove();
    frame.classList.remove('has-gif');
    const media = prefersReducedMotion() ? new Image() : document.createElement('video');
    media.className = 'theme-gif';
    const done = () => frame.classList.remove('is-loading');
    const ready = () => {
      done();
      frame.classList.add('has-gif');
    };
    media.addEventListener('error', done, { once: true });
    if (media instanceof HTMLVideoElement) {
      media.muted = true;
      media.loop = true;
      media.autoplay = true;
      media.playsInline = true;
      media.disablePictureInPicture = true;
      media.addEventListener('loadeddata', ready, { once: true });
      media.src = gif.mp4;
    } else {
      media.alt = '';
      media.decoding = 'async';
      media.addEventListener('load', ready, { once: true });
      media.src = gif.still;
    }
    frame.append(media);
  }

  async function load(frame: HTMLElement) {
    const timer = window.setTimeout(() => frame.classList.add('is-loading'), LOADER_DELAY_MS);
    // Pas de GIF (Giphy indisponible, quota atteint, rien trouvé) : on retire l'indicateur.
    const giveUp = () => {
      window.clearTimeout(timer);
      frame.classList.remove('is-loading');
    };
    try {
      const id = encodeURIComponent(frame.dataset['categoryGif'] ?? '');
      const response = await fetch(`/api/category-gif/${id}`);
      if (!response.ok) return giveUp();
      const plan = (await response.json()) as CategoryGiphyPlan;
      const found = await giphyClientFor(plan.key).categoryGif(plan);
      const gif = found ? thumbnailOf(found) : null;
      if (!gif?.mp4 || !gif.still) return giveUp();
      thumbnails.set(frame, gif);
      show(frame, gif);
      // L'indicateur reste jusqu'à ce que l'image soit prête (voir show).
      window.clearTimeout(timer);
      if (!frame.classList.contains('has-gif')) frame.classList.add('is-loading');
    } catch {
      giveUp();
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        void load(entry.target as HTMLElement);
      }
    },
    { rootMargin: '300px 0px' },
  );
  frames.forEach((frame) => observer.observe(frame));

  // L'interrupteur « Animations » bascule les vignettes entre vidéo et image fixe.
  window.addEventListener(MOTION_EVENT, () => {
    thumbnails.forEach((gif, frame) => show(frame, gif));
  });
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 24px;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /*
   * La phrase du prototype, en Anton géant ; la troisième ligne en rose.
   * Taille calculée pour que « un portfolio sérieux. » tienne sur une ligne de 360 à 1280 px.
   */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 9.4vw, 8rem);
    /* Assez d'interligne pour que les accents (É) et la cédille (Ç) ne mordent pas sur les lignes voisines. */
    line-height: 1.1;
    text-transform: uppercase;
    /* Place pour la cédille de « ÇA » au-dessus du chapeau. */
    padding-bottom: 0.08em;
  }

  /* Les trois lignes se dévoilent l'une après l'autre : elles montent et passent du flou au net. */
  .hero-title span {
    display: block;
    animation: title-reveal 900ms var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 110ms);
  }

  .hero-title span:last-child {
    color: var(--pink);
  }

  @keyframes title-reveal {
    from {
      opacity: 0;
      transform: translateY(0.3em);
      filter: blur(14px);
    }
  }

  .hero-intro {
    max-width: 680px;
    font-size: 1.25rem;
    animation: rise-in 700ms var(--ease-out) 380ms backwards;
  }

  /* « Tout mélangé » : une grande carte en tête, en largeur. */
  .theme-card.theme-card--mixed {
    min-height: 0;
  }

  .theme-card--mixed .theme-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .universe {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .universe-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 20px;
    animation: rise-in 700ms var(--ease-out) 400ms backwards;
  }

  .universe-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .universe-tagline {
    flex: 1 1 280px;
    color: var(--fg-muted);
  }

  .universe-play {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--yellow);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  /* Toujours 4 colonnes (2 sur mobile), quel que soit le nombre de catégories de l'univers. */
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    min-height: 250px;
    padding: 22px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--fg);
    text-decoration: none;
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out);
    /* Les cartes montent en fondu, en cascade, après le titre. */
    animation: card-rise 700ms var(--ease-out) backwards;
    animation-delay: calc(450ms + min(var(--i), 8) * 60ms);
  }

  /*
   * Survol : la carte se décolle en diagonale, son ombre s'allonge, et un reflet la balaie.
   * Au clic, elle s'enfonce dans son ombre, comme un bouton qu'on presse.
   */
  .theme-card:hover,
  .theme-card:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 var(--fg);
  }

  .theme-card:active {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--fg);
    transition-duration: 80ms;
  }

  .theme-card:hover .theme-play,
  .theme-card:focus-visible .theme-play {
    transform: translateX(6px);
  }

  .theme-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgb(255 255 255 / 0.45) 48%,
      rgb(255 255 255 / 0.15) 54%,
      transparent 70%
    );
    transform: translateX(-110%);
    pointer-events: none;
  }

  /* Le reflet ne passe qu'à l'entrée : à la sortie, il revient sans transition. */
  .theme-card:hover::after,
  .theme-card:focus-visible::after {
    transform: translateX(110%);
    transition: transform 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-card {
    position: relative;
    overflow: hidden;
  }

  /* « Tout mélangé » : grande icône à droite ; elle flotte au survol. */
  .theme-card--mixed :global(.theme-icon) {
    position: absolute;
    opacity: 0.85;
    transition:
      transform 320ms var(--ease-out),
      opacity 320ms ease,
      filter 320ms ease;
  }

  .theme-card--mixed:hover :global(.theme-icon),
  .theme-card--mixed:focus-visible :global(.theme-icon) {
    opacity: 1;
    transform: translateY(-6px) scale(1.12);
    filter: drop-shadow(3px 5px 0 rgb(0 0 0 / 0.18));
  }

  .theme-card--mixed :global(.theme-icon) {
    width: clamp(64px, 9vw, 110px);
    height: clamp(64px, 9vw, 110px);
    top: 50%;
    right: clamp(20px, 4vw, 48px);
    margin-top: calc(clamp(64px, 9vw, 110px) / -2);
  }

  /* Le nom ne passe pas sous la grande icône. */
  .theme-card--mixed .theme-name {
    padding-right: clamp(84px, 12vw, 170px);
  }

  /* Cadre 16:9 de la vignette : rayé, avec l'icône, tant que le GIF n'est pas prêt. */
  .theme-media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 3px solid var(--ink);
    background: repeating-linear-gradient(
      45deg,
      rgb(0 0 0 / 0.1) 0 14px,
      rgb(0 0 0 / 0.02) 14px 28px
    );
  }

  .theme-media :global(.theme-icon) {
    width: 44px;
    height: 44px;
    opacity: 0.8;
  }

  /* Chargement : trois points qui pulsent sous l'icône, seulement si l'attente dure. */
  .theme-loader {
    position: absolute;
    bottom: 12%;
    left: 50%;
    display: none;
    gap: 5px;
    transform: translateX(-50%);
  }

  .theme-media:global(.is-loading) .theme-loader {
    display: flex;
  }

  .theme-loader span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    animation: theme-loader-dot 900ms ease-in-out infinite;
  }

  .theme-loader span:nth-child(2) {
    animation-delay: 150ms;
  }

  .theme-loader span:nth-child(3) {
    animation-delay: 300ms;
  }

  @keyframes theme-loader-dot {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }

  /* Le GIF recouvre le cadre une fois prêt (fondu), et zoome un peu au survol de la carte. */
  .theme-media :global(.theme-gif) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition:
      opacity 200ms ease,
      transform 300ms ease;
  }

  .theme-media:global(.has-gif) :global(.theme-gif) {
    opacity: 1;
  }

  .theme-card:hover .theme-media :global(.theme-gif),
  .theme-card:focus-visible .theme-media :global(.theme-gif) {
    transform: scale(1.06);
  }

  .universe-title {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .universe-title :global(.universe-icon) {
    width: 0.8em;
    height: 0.8em;
    color: var(--yellow);
  }

  @keyframes card-rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  .theme-name {
    font-family: var(--font-display);
    font-size: 2.125rem;
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .theme-tagline {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .theme-play {
    transition: transform 180ms ease;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
  }

  /* Tablette et mobile : cartes compactes. */
  @media (max-width: 1100px) {
    .theme-grid .theme-card {
      gap: 8px;
      padding: 16px;
    }

    .theme-grid .theme-card .theme-name {
      font-size: 1.5rem;
    }

    .theme-grid .theme-tagline {
      font-size: 0.875rem;
      line-height: 1.35;
    }
  }

  /* Mobile : deux colonnes. */
  @media (max-width: 720px) {
    .theme-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .theme-grid .theme-card {
      min-height: 200px;
      padding: 12px;
      box-shadow: 4px 4px 0 var(--fg);
    }

    .theme-media {
      border-width: 2px;
    }

    .theme-media :global(.theme-icon) {
      width: 30px;
      height: 30px;
    }

    .theme-grid .theme-card .theme-name {
      font-size: 1.375rem;
    }

    .theme-grid .theme-tagline {
      font-size: 0.8125rem;
    }

    .theme-grid .theme-play {
      font-size: 0.75rem;
    }
  }

  .footnote {
    animation: rise-in 700ms var(--ease-out) 1000ms backwards;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
