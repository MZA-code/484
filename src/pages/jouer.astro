---
/**
 * Page des duels. Le jeu est un îlot Preact rendu côté client uniquement :
 * le thème vient de l'URL (?theme=) et la partie du stockage local.
 * Un squelette de même taille s'affiche pendant le chargement, pour éviter les sauts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Game from '../islands/game/Game';
import type { GameData } from '../islands/game/types';
import { contenders, themes, ui } from '../data/content';

const data: GameData = {
  themes: themes.map(({ id, label }) => ({ id, label })),
  contenders: contenders.map(({ id, theme, name, origin, line }) => ({
    id,
    theme,
    name,
    origin,
    line,
  })),
  texts: {
    duel: ui.duel,
    quips: ui.quips,
    milestones: ui.milestones,
    panels: ui.panels,
    mixedLabel: ui.home.mixedTheme.label,
    linkedinUrl: ui.links.linkedin.url,
  },
};
---

<BaseLayout title={ui.duel.pageTitle}>
  <div class="container">
    <Game client:only="preact" data={data}>
      <div slot="fallback" class="skeleton" aria-busy="true">
        <p class="skeleton-text">{ui.duel.loading}</p>
        <div class="skeleton-arena">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>
      </div>
    </Game>
    <noscript>
      <p class="noscript">{ui.duel.noscript}</p>
    </noscript>
  </div>
</BaseLayout>

<style>
  .skeleton {
    padding-top: 8px;
  }

  .skeleton-text {
    min-height: 60px;
    padding-top: 80px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .skeleton-arena {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 124px;
    margin-top: 160px;
  }

  .skeleton-card {
    min-height: 420px;
    border-radius: var(--radius);
    background: #1c1c1c;
  }

  @media (max-width: 720px) {
    .skeleton-arena {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .noscript {
    margin-top: 32px;
    padding: 16px;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
