---
/**
 * Page des débats. Le jeu est un îlot Preact rendu côté client uniquement :
 * la catégorie vient de l'URL (?theme=) et la partie du stockage local.
 * Un squelette de même taille s'affiche pendant le chargement, pour éviter les sauts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Debate from '../islands/debate/Debate';
import type { DebateData } from '../islands/debate/types';
import { categories, rivalries, ui, universes } from '../data/content';

const team = ({ name, origin, line }: { name: string; origin: string; line: string }) => ({
  name,
  origin,
  line,
});

const data: DebateData = {
  universes: universes.map(({ id, label, categories }) => ({ id, label, categories })),
  categories: categories.map(({ id, label }) => ({ id, label })),
  rivalries: rivalries.map((r) => ({
    id: r.id,
    category: r.category,
    question: r.question,
    a: team(r.a),
    b: team(r.b),
  })),
  texts: {
    debate: ui.debate,
    quips: ui.quips,
    milestones: ui.milestones,
    mixedLabel: ui.home.mixedTheme.label,
    linkedinUrl: ui.links.linkedin.url,
  },
};
---

<BaseLayout title={ui.debate.pageTitle}>
  <div class="container">
    <Debate client:only="preact" data={data}>
      <div slot="fallback" class="skeleton" aria-busy="true">
        <p class="skeleton-text">{ui.debate.loading}</p>
        <div class="skeleton-arena">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>
      </div>
    </Debate>
    <noscript>
      <p class="noscript">{ui.debate.noscript}</p>
    </noscript>
  </div>
</BaseLayout>

<style>
  .skeleton-text {
    min-height: 220px;
    padding-top: 120px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .skeleton-arena {
    display: flex;
    flex-wrap: wrap;
    gap: 124px;
  }

  .skeleton-card {
    flex: 1 1 340px;
    min-height: 400px;
    background: #1c1c1c;
  }

  @media (max-width: 720px) {
    .skeleton-arena {
      gap: 84px;
    }
  }

  .noscript {
    margin-top: 32px;
    padding: 16px;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
