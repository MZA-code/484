---
/**
 * Gabarit commun : balises meta, en-tête (logo + liens) et pied de page.
 * Tous les textes viennent de `content/ui-texts.fr.json`.
 */
import '../styles/global.css';
import { version } from '../../package.json';
import { rivalries, ui } from '../data/content';
import { formatText } from '../lib/format';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/og-path';
import { serializeJsonLd } from '../lib/seo';

interface Props {
  /** Titre de l'onglet, avant « · 484 · Lequel tu préfères ? ». Absent sur l'accueil. */
  title?: string | undefined;
  description?: string | undefined;
  /** Chemin de l'image de partage ; par défaut, l'image générale du site. */
  image?: string | undefined;
  /** Données structurées (schema.org) propres à la page. */
  jsonLd?: readonly unknown[] | undefined;
}

const {
  title,
  description = ui.site.description,
  image = ogImagePath(),
  jsonLd = [],
} = Astro.props;
const fullTitle = title ? `${title} · ${ui.site.title}` : ui.site.title;
const links = [ui.links.github, ui.links.linkedin].filter((link) => link.url !== '');
// Adresse canonique, sans paramètres : c'est elle qui circule quand on partage la page.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site ?? Astro.url).href;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;

/** Des GIF viennent-ils de Tenor (liens choisis à la main) ? Alors on le mentionne. */
const usesTenor = rivalries.some(
  (r) => (r.a.gifUrls?.length ?? 0) + (r.b.gifUrls?.length ?? 0) > 0,
);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={ui.site.title} />
    <meta property="og:title" content={title ?? ui.site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title ?? ui.site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => (
      <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />
    ))}
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Préférence d'animations choisie avec l'interrupteur (voir src/lib/motion.ts),
      // posée avant l'affichage pour éviter tout clignotement.
      try {
        const motion = localStorage.getItem('484:motion');
        if (motion === 'full' || motion === 'reduced')
          document.documentElement.dataset.motion = motion;
      } catch {
        // Stockage indisponible : on suit simplement le réglage du système.
      }
      // Mode admin (voir src/lib/admin.ts) : #admin=<jeton> l'active, #admin=off le coupe.
      try {
        const match = /^#admin=(.+)$/.exec(location.hash);
        if (match) {
          if (match[1] === 'off') localStorage.removeItem('484:admin');
          else localStorage.setItem('484:admin', decodeURIComponent(match[1]));
          history.replaceState(null, '', location.pathname + location.search);
        }
      } catch {
        // Stockage indisponible : pas de mode admin sur cet appareil.
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      {ui.site.skipToContent}
    </a>

    <header class="site-header container">
      <a class="brand" href="/">
        <span class="brand-logo">{ui.site.logo}</span>
        <span class="brand-name">{ui.site.name}</span>
      </a>
      <div class="header-tools">
        <button
          type="button"
          class="motion-toggle"
          data-motion-toggle
          data-on={ui.site.motion.on}
          data-off={ui.site.motion.off}
          aria-pressed="true"
        >
          {ui.site.motion.label} <span data-motion-state>{ui.site.motion.on}</span>
        </button>
        {links.length > 0 && (
          <nav class="social" aria-label={ui.site.socialLabel}>
            {links.map((link) => (
              <a href={link.url} rel="me noopener" target="_blank">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer container">
      {/* 1. Le mot de la fin. */}
      <p class="footer-disclaimer">{ui.footer.disclaimer}</p>

      {/* 2. Le site et son auteur, puis les marques d'attribution des GIF (exigées par GIPHY et Tenor). */}
      <div class="footer-row">
        <nav class="footer-links" aria-label={ui.footer.links}>
          <a class="footer-hall" href="/hall-of-fame">
            {ui.footer.hallOfFame}
          </a>
          <a class="footer-projects" href="/projets">
            {ui.footer.projects}
          </a>
        </nav>
        <div class="footer-credits">
          {/* Badge officiel « Powered by GIPHY », fixe si les animations sont réduites. */}
          <a class="footer-badge" href={ui.footer.giphy.url} rel="noopener" target="_blank">
            <img
              class="giphy-badge-animated"
              src="/images/giphy/powered-by-giphy.gif"
              width="200"
              height="42"
              alt={ui.footer.giphy.label}
              loading="lazy"
              decoding="async"
            />
            <img
              class="giphy-badge-still"
              src="/images/giphy/powered-by-giphy.png"
              width="200"
              height="42"
              alt={ui.footer.giphy.label}
              loading="lazy"
              decoding="async"
            />
          </a>
          {usesTenor && (
            <a
              class="footer-badge footer-badge-tenor"
              href={ui.footer.tenor.url}
              rel="noopener"
              target="_blank"
            >
              <img
                src="/images/tenor/powered-by-tenor.svg"
                width="141"
                height="18"
                alt={ui.footer.tenor.label}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
        </div>
      </div>

      {/* 3. Informations légales et version. */}
      <div class="footer-bottom">
        <nav class="footer-legal" aria-label={ui.footer.legal.label}>
          <ul>
            <li>
              <a href="/debats">{ui.footer.legal.debates}</a>
            </li>
            <li>
              <a href="/a-propos">{ui.footer.legal.about}</a>
            </li>
            <li>
              <a href="/mentions-legales">{ui.footer.legal.mentions}</a>
            </li>
            <li>
              <a href="/confidentialite">{ui.footer.legal.privacy}</a>
            </li>
            <li>
              <a href="/accessibilite">{ui.footer.legal.accessibility}</a>
            </li>
          </ul>
        </nav>
        <p class="footer-version">{formatText(ui.footer.version, { version })}</p>
      </div>
      <slot name="footer" />
    </footer>
    <script is:inline>
      // Interrupteur « Animations » : bascule la préférence et prévient les îlots.
      {
        const root = document.documentElement;
        const button = document.querySelector('[data-motion-toggle]');
        const label = button?.querySelector('[data-motion-state]');
        const reduced = () => {
          if (root.dataset.motion === 'full') return false;
          if (root.dataset.motion === 'reduced') return true;
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        };
        const render = () => {
          const on = !reduced();
          button?.setAttribute('aria-pressed', String(on));
          if (label && button) label.textContent = on ? button.dataset.on : button.dataset.off;
        };
        button?.addEventListener('click', () => {
          const next = reduced() ? 'full' : 'reduced';
          root.dataset.motion = next;
          try {
            localStorage.setItem('484:motion', next);
          } catch {
            // Stockage indisponible : le choix vaut pour cette page seulement.
          }
          render();
          window.dispatchEvent(new Event('484:motionchange'));
        });
        render();
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px;
  }

  /* Logo du prototype : « 484 » sur pavé jaune, puis le nom du site, en Anton. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.625rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .brand-logo {
    padding: 0 10px;
    background: var(--yellow);
    color: var(--ink);
  }

  .brand-name {
    text-transform: uppercase;
  }

  .header-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }

  .motion-toggle {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .motion-toggle:hover {
    color: var(--fg);
  }

  .motion-toggle [data-motion-state] {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--yellow);
  }

  .social a span {
    margin-left: 0.3em;
  }

  .social a:hover {
    color: #fff;
  }

  /*
   * Pied de page en trois étages : le mot de la fin ; les liens du site et de l'auteur à
   * gauche, les marques d'attribution des GIF à droite ; enfin les informations légales et la
   * version, sous un filet.
   */
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 56px;
    padding-block: 32px 24px;
    border-top: 1px solid #3a3a3a;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .footer-disclaimer {
    margin: 0;
    color: var(--fg);
    font-style: italic;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
  }

  .footer-hall,
  .footer-projects {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .footer-hall {
    color: var(--fg);
  }

  .footer-projects {
    color: var(--yellow);
    text-decoration: underline;
  }

  .footer-projects:hover,
  .footer-hall:hover {
    color: #fff;
  }

  /* Marques d'attribution : les badges officiels, tels que fournis, à la même hauteur. */
  .footer-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .footer-badge {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-badge img {
    display: block;
  }

  /* Le logo Tenor (blanc, sans fond) posé sur un fond noir de la hauteur du badge GIPHY. */
  .footer-badge-tenor img {
    box-sizing: content-box;
    width: 141px;
    height: 18px;
    padding: 12px;
    background: #000;
  }

  /* Une seule des deux images GIPHY est visible : l'animée, ou la fixe si les animations sont réduites. */
  .giphy-badge-still {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:root:not([data-motion='full'])) .giphy-badge-animated {
      display: none !important;
    }

    :global(:root:not([data-motion='full'])) .giphy-badge-still {
      display: block !important;
    }
  }

  :global(:root[data-motion='reduced']) .giphy-badge-animated {
    display: none !important;
  }

  :global(:root[data-motion='reduced']) .giphy-badge-still {
    display: block !important;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
    padding-top: 12px;
    border-top: 1px dashed #3a3a3a;
  }

  .footer-legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-muted);
    text-underline-offset: 3px;
  }

  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: var(--fg);
  }

  .footer-version {
    margin: 0;
    font-size: 0.75rem;
  }
</style>
