---
/**
 * Gabarit commun : balises meta, en-tête (logo + liens) et pied de page.
 * Tous les textes viennent de `content/ui-texts.fr.json`.
 */
import '../styles/global.css';
import { ui } from '../data/content';

interface Props {
  /** Titre de l'onglet, avant « · 484 · Lequel tu préfères ? ». Absent sur l'accueil. */
  title?: string;
  description?: string;
}

const { title, description = ui.site.description } = Astro.props;
const fullTitle = title ? `${title} · ${ui.site.title}` : ui.site.title;
const links = [ui.links.github, ui.links.linkedin].filter((link) => link.url !== '');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      {ui.site.skipToContent}
    </a>

    <header class="site-header container">
      <a class="brand" href="/">
        <span class="brand-logo">{ui.site.logo}</span>
        <span class="brand-name">{ui.site.name}</span>
      </a>
      {links.length > 0 && (
        <nav class="social" aria-label={ui.site.socialLabel}>
          {links.map((link) => (
            <a href={link.url} rel="me noopener" target="_blank">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      )}
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer container">
      <a class="footer-projects" href="/projets">
        {ui.footer.projects}
      </a>
      <a class="footer-hall" href="/hall-of-fame">
        {ui.footer.hallOfFame}
      </a>
      <p class="footer-disclaimer">{ui.footer.disclaimer}</p>
      <a class="footer-giphy" href={ui.footer.giphy.url} rel="noopener" target="_blank">
        {ui.footer.giphy.label}
      </a>
      <slot name="footer" />
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px;
  }

  /* Logo du prototype : « 484 » sur pavé jaune, puis le nom du site, en Anton. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.625rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .brand-logo {
    padding: 0 10px;
    background: var(--yellow);
    color: var(--ink);
  }

  .brand-name {
    text-transform: uppercase;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--yellow);
  }

  .social a span {
    margin-left: 0.3em;
  }

  .social a:hover {
    color: #fff;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid #3a3a3a;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .footer-projects {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--yellow);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-projects:hover,
  .footer-hall:hover {
    color: #fff;
  }

  .footer-hall {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg);
    font-weight: 700;
    text-underline-offset: 4px;
  }

  /* Attribution Giphy obligatoire, mais discrète. */
  .footer-giphy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .footer-giphy:hover {
    color: var(--fg);
  }
</style>
