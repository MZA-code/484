---
/**
 * Page de débat : utilisée par /jouer (rivalité au hasard) et par /debat/<id> (lien partagé).
 * L'îlot est rendu côté client ; il charge les rivalités depuis /data/debate.json.
 *
 * Sur /debat/<id>, le contenu d'attente est la version statique du débat (question, deux teams) :
 * c'est ce que lisent les moteurs de recherche et les robots qui n'exécutent pas JavaScript.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DebateApp from '../islands/debate/DebateApp';
import { DEBATE_DATA_URL } from '../data/debate-data';
import { ui } from '../data/content';

interface StaticTeam {
  name: string;
  origin: string;
  line: string;
  color: string;
}

interface Props {
  title: string;
  description?: string | undefined;
  initialRivalry?: string | undefined;
  image?: string | undefined;
  jsonLd?: readonly unknown[] | undefined;
  /** Version statique du débat, affichée jusqu'au démarrage du jeu. */
  staticDebate?: { question: string; category: string; a: StaticTeam; b: StaticTeam } | undefined;
}

const { title, description, initialRivalry, image, jsonLd, staticDebate } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} jsonLd={jsonLd}>
  <div class="container">
    <DebateApp
      client:only="preact"
      dataUrl={DEBATE_DATA_URL}
      initialRivalry={initialRivalry}
      loadingText={ui.debate.loading}
      errorText={ui.debate.loadError}
    >
      {staticDebate ? (
        <div slot="fallback" class="static-debate" aria-busy="true">
          <p class="static-category">{staticDebate.category}</p>
          <h1 class="static-question">{staticDebate.question}</h1>
          <div class="static-arena">
            {[staticDebate.a, staticDebate.b].map((team, i) => (
              <>
                {i === 1 && (
                  <p class="static-vs" aria-hidden="true">
                    {ui.debate.vs}
                  </p>
                )}
                <div class="static-card" style={`--card: ${team.color}`}>
                  <p class="static-tag">{ui.debate.team}</p>
                  <h2 class="static-name">{team.name}</h2>
                  <p class="static-origin">{team.origin}</p>
                  <p class="static-line">{team.line}</p>
                </div>
              </>
            ))}
          </div>
        </div>
      ) : (
        <div slot="fallback" class="skeleton" aria-busy="true">
          <p class="skeleton-text">{ui.debate.loading}</p>
          <div class="skeleton-arena">
            <div class="skeleton-card" />
            <div class="skeleton-card" />
          </div>
        </div>
      )}
    </DebateApp>
    <noscript>
      <p class="noscript">{ui.debate.noscript}</p>
    </noscript>
    <slot name="after" />
  </div>
</BaseLayout>

<style>
  .skeleton-text {
    min-height: 220px;
    padding-top: 120px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .skeleton-arena {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 124px;
  }

  .skeleton-card {
    min-height: 400px;
    background: #1c1c1c;
  }

  @media (max-width: 720px) {
    .skeleton-arena {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .skeleton-card {
      min-height: 300px;
    }
  }

  /* Débat statique : même place que le jeu (onglets et numéro au-dessus), sans les GIF. */
  .static-debate {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 132px;
  }

  .static-category {
    color: var(--yellow);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .static-question {
    margin-bottom: 18px;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.4vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .static-arena {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 20px;
  }

  .static-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    min-height: 400px;
    padding: 24px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--fg);
  }

  .static-tag {
    align-self: flex-start;
    padding: 4px 10px;
    background: var(--ink);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .static-name {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .static-origin {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .static-line {
    font-style: italic;
  }

  .static-vs {
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    margin: 0 auto;
    border-radius: 50%;
    background: var(--fg);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 2.25rem;
  }

  /* Mobile : face à face en deux colonnes, comme le jeu. */
  @media (max-width: 720px) {
    .static-arena {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      gap: 14px;
    }

    .static-card {
      min-height: 300px;
      gap: 8px;
      padding: 10px;
      box-shadow: 4px 4px 0 var(--fg);
    }

    .static-tag {
      padding: 3px 6px;
      font-size: 0.6875rem;
    }

    .static-name {
      font-size: clamp(1.25rem, 6.4vw, 1.75rem);
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .static-origin {
      font-size: 0.6875rem;
    }

    .static-line {
      font-size: 0.8125rem;
    }

    .static-vs {
      position: absolute;
      z-index: 1;
      top: calc(50% - 24px);
      left: calc(50% - 24px);
      width: 48px;
      height: 48px;
      margin: 0;
      font-size: 1.375rem;
    }
  }

  .noscript {
    margin-top: 32px;
    padding: 16px;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
